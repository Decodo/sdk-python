{
  "version": "1.0.0",
  "apis": {
    "webScrapingApi": {
      "parameters": {
        "GEOLOCATION_NAME": {
          "type": "string",
          "description": "Shared geolocation parameter"
        }
      },
      "targets": {
        "google_search": {
          "group": "Google",
          "response_format": "json",
          "parameter_schema": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "const": "google_search"
              },
              "query": {
                "type": "string"
              },
              "parse": {
                "type": "boolean"
              }
            },
            "required": [
              "target",
              "query"
            ]
          }
        }
      }
    },
    "dataApi": {
      "label": "Data API",
      "baseUrl": "https://data.decodo.com",
      "auth": {
        "type": "bearer"
      },
      "endpoints": {
        "runSearch": {
          "method": "POST",
          "path": "/v1/search",
          "requestSchema": {
            "type": "object",
            "required": [
              "query"
            ],
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "number",
                "minimum": 1
              }
            }
          }
        },
        "mapSite": {
          "method": "POST",
          "path": "/v1/map",
          "requestSchema": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "limit": {
                "type": "integer"
              }
            }
          }
        },
        "startCrawl": {
          "method": "POST",
          "path": "/v1/crawl",
          "requestSchema": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          }
        },
        "getCrawlStatus": {
          "method": "GET",
          "path": "/v1/crawl/{id}/status"
        }
      }
    }
  }
}
