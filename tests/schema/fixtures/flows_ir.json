  "flows": {
    "scrape": {
      "pattern": "call",
      "run": "scrapePage"
    },
    "search": {
      "pattern": "call",
      "run": "runSearch"
    },
    "map": {
      "pattern": "call",
      "run": "mapSite"
    },
    "task": {
      "pattern": "job",
      "start": "queueTask",
      "status": "getTask",
      "results": "getTaskResults",
      "idField": "id",
      "statusField": "status",
      "pendingStatuses": [
        "pending"
      ],
      "failedStatuses": [
        "faulted"
      ],
      "pollSeconds": 5
    },
    "crawl": {
      "pattern": "job",
      "start": "startCrawl",
      "status": "getCrawlStatus",
      "results": "listCrawlPages",
      "cancel": "cancelCrawl",
      "idField": "crawl_id",
      "statusField": "status",
      "pendingStatuses": [
        "pending"
      ],
      "failedStatuses": [
        "faulted",
        "cancelled"
      ],
      "resultsQuery": {
        "type": "content"
      },
      "pagination": {
        "itemsField": "url",
        "nextUrlField": "next"
      },
      "pollSeconds": 5
    },
    "task_batch": {
      "pattern": "batch",
      "start": "queueTaskBatch",
      "itemsField": "queries",
      "job": "task"
    }
  },
  "keyCheck": {
    "flow": "scrape",
    "params": {
      "target": "universal",
      "url": "https://does-not-exist.decodo.com"
    }
  },
  "surfaces": {
    "google-adk-python": {
      "tools": [
        {
          "name": "decodo_search",
          "description": "Search the web and get ranked results with titles, links and snippets. Use it first to find pages on a topic; use decodo_scrape to read one of them.",
          "flow": "search",
          "result": {
            "failures": [
              {
                "path": "status",
                "equals": "failed",
                "message": "message",
                "code": "status_code",
                "retryable": true
              }
            ],
            "omit": [
              "search_parameters"
            ]
          },
          "limits": {
            "maxResultChars": 60000,
            "maxTextChars": 40000,
            "maxItems": 50,
            "maxListValues": 500
          },
          "fields": [
            "query",
            "geo",
            "locale",
            "page"
          ],
          "descriptions": {
            "query": "The search query.",
            "geo": "Country or city to search from, for example 'United States'.",
            "locale": "Interface language of the results, for example 'en-us'.",
            "page": "Results page number, a whole number starting at 1."
          }
        },
        {
          "name": "decodo_scrape",
          "description": "Read one web page and get its content as markdown. Use it when you already have the URL. To read many pages of one site, use decodo_crawl_start instead.",
          "flow": "scrape",
          "result": {
            "failures": [
              {
                "path": "status",
                "equals": "failed",
                "message": "message",
                "code": "status_code",
                "retryable": true
              },
              {
                "path": "results.0.status_code",
                "atLeast": 400
              }
            ],
            "from": "results.0",
            "fields": {
              "url": "url",
              "content": "content"
            },
            "required": [
              "content"
            ]
          },
          "limits": {
            "maxResultChars": 60000,
            "maxTextChars": 40000,
            "maxItems": 50,
            "maxListValues": 500
          },
          "target": "universal",
          "fields": [
            "url",
            "geo",
            "headless"
          ],
          "required": [
            "url"
          ],
          "fixed": {
            "target": "universal",
            "markdown": true
          },
          "descriptions": {
            "url": "Absolute http or https URL of the page.",
            "geo": "Country to load the page from, for example 'Germany'.",
            "headless": "Set to 'html' to render JavaScript when the page comes back empty without it."
          }
        },
        {
          "name": "decodo_map",
          "description": "List the URLs of a site without reading them. Use it to see what a site contains before choosing pages to scrape or a section to crawl.",
          "flow": "map",
          "result": {
            "from": "results.0",
            "fields": {
              "url": "url",
              "links": "content.links.*.url"
            }
          },
          "limits": {
            "maxResultChars": 60000,
            "maxTextChars": 40000,
            "maxItems": 50,
            "maxListValues": 500
          },
          "fields": [
            "url",
            "limit",
            "sitemap",
            "domain_filter"
          ],
          "defaults": {
            "limit": 100
          },
          "minimums": {
            "limit": 1
          },
          "maximums": {
            "limit": 500
          },
          "descriptions": {
            "url": "Absolute http or https URL of the site.",
            "limit": "How many URLs to return, 100 unless set and 500 at most.",
            "sitemap": "'include' reads the sitemap and the pages, 'only' reads just the sitemap, 'skip' ignores it.",
            "domain_filter": "'domain' stays on the site, 'subdomain' adds its subdomains, 'all' follows any link."
          }
        },
        {
          "name": "decodo_crawl_start",
          "description": "Start reading many pages of one site, following its links. Returns a crawl_id at once; the pages come from decodo_crawl_results. Keep limit small: every page is billed.",
          "flow": "crawl",
          "step": "start",
          "fields": [
            "url",
            "limit",
            "max_depth",
            "domain_filter"
          ],
          "fixed": {
            "output": "markdown"
          },
          "defaults": {
            "limit": 10
          },
          "maximums": {
            "limit": 50
